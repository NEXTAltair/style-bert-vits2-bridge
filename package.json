{
  "name": "style-bert-vits2-bridge",
  "version": "0.0.1",
  "description": "Bridge OpenClaw to a Style-Bert-VITS2 API server for speech generation.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sbv2-bridge": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "scripts",
    "openclaw.plugin.json",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
      "minGatewayVersion": "2026.3.24-beta.2"
    }
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.24-beta.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "check:sbv2": "node scripts/check-sbv2-runtime.mjs",
    "prepack": "pnpm run build",
    "sbv2-bridge": "node dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "json5": "^2.2.3"
  }
}
