{
  "id": "style-bert-vits2-bridge",
  "name": "Style-Bert-VITS2 Bridge",
  "description": "Bridge OpenClaw to a Style-Bert-VITS2 API server for speech generation.",
  "version": "0.0.1",
  "skills": [
    "./skills/voice",
    "./skills/pr-maintainer"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseUrl": { "type": "string", "minLength": 1 },
      "timeoutMs": { "type": "integer", "minimum": 1000 },
      "modelName": { "type": "string" },
      "modelId": { "type": "integer" },
      "speakerId": { "type": "integer" },
      "speakerName": { "type": "string" },
      "style": { "type": "string" },
      "styleWeight": { "type": "number" },
      "length": { "type": "number" },
      "language": { "type": "string", "enum": ["JP", "EN", "ZH"] },
      "assistText": { "type": "string" },
      "assistTextWeight": { "type": "number" },
      "defaultModelName": { "type": "string" },
      "defaultModelId": { "type": "integer" },
      "defaultSpeakerId": { "type": "integer" },
      "defaultSpeakerName": { "type": "string" },
      "defaultStyle": { "type": "string" },
      "defaultStyleWeight": { "type": "number" },
      "defaultLength": { "type": "number" },
      "defaultLanguage": { "type": "string", "enum": ["JP", "EN", "ZH"] },
      "defaultAssistText": { "type": "string" },
      "defaultAssistTextWeight": { "type": "number" }
    }
  },
  "uiHints": {
    "baseUrl": {
      "label": "SBV2 API Base URL",
      "placeholder": "http://127.0.0.1:5000"
    },
    "timeoutMs": {
      "label": "Request Timeout (ms)",
      "placeholder": "30000"
    },
    "modelName": {
      "label": "Model Name",
      "placeholder": "Legacy alias for Default Model Name"
    },
    "speakerName": {
      "label": "Speaker Name",
      "placeholder": "Legacy alias for Default Speaker Name"
    },
    "style": {
      "label": "Style",
      "placeholder": "Legacy alias for Default Style"
    },
    "defaultModelName": {
      "label": "Default Model Name",
      "placeholder": "valentina01_bright"
    },
    "defaultSpeakerId": {
      "label": "Default Speaker ID",
      "placeholder": "Optional default speaker id"
    },
    "defaultSpeakerName": {
      "label": "Default Speaker Name",
      "placeholder": "valentina01_bright"
    },
    "defaultStyle": {
      "label": "Default Style",
      "placeholder": "00_Neutral"
    }
  }
}
